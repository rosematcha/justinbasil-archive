---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  sourceUrl?: string;
  /** Show the page <h1>; some pages bake their own title into the body. */
  showHeading?: boolean;
}

const { title, description, ogImage, sourceUrl, showHeading = true } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} sourceUrl={sourceUrl}>
  <article class="jb-container jb-content">
    {showHeading && <h1>{title}</h1>}
    <slot />
  </article>
</BaseLayout>
